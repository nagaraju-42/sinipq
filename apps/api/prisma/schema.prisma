generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  OWNER
  BARBER
}

enum SlotStatus {
  AVAILABLE
  CONFIRMED
  WALK_IN
  BLOCKED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  email        String?  @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  salonsOwned   Salon[]   @relation("SalonOwner")
  barberProfile Barber?
  bookings      Booking[]
}

model Salon {
  id        String   @id @default(uuid())
  name      String
  address   String
  ownerId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner   User     @relation("SalonOwner", fields: [ownerId], references: [id])
  barbers Barber[]
}

model Barber {
  id          String   @id @default(uuid())
  salonId     String
  userId      String   @unique
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  salon Salon  @relation(fields: [salonId], references: [id])
  user  User   @relation(fields: [userId], references: [id])
  slots Slot[]
}

model Slot {
  id        String     @id @default(uuid())
  barberId  String
  startTime DateTime
  endTime   DateTime
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  barber  Barber   @relation(fields: [barberId], references: [id])
  booking Booking?
}

model Booking {
  id                String   @id @default(uuid())
  slotId            String   @unique
  customerId        String
  razorpayPaymentId String? // Nullable until the ₹10 fee is paid
  checkInOtp        String // 4-digit code generated on confirmation
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  slot     Slot @relation(fields: [slotId], references: [id])
  customer User @relation(fields: [customerId], references: [id])
}
